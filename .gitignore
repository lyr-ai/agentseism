__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.DS_Store

# raw experiment dumps (large, regenerable); summary artifacts are committed
results/*_experiment.json

# Step archives: 86 MB of tar and diff blobs. See data/README.md — kept local,
# deliberately not versioned, and the risk of losing them is recorded there.
data/runs/*/*.archive/
.venv-eval/

# SWE-bench harness output from **local integration tests**: regenerable by
# re-running them, so not versioned.
#
# This does NOT apply to a real run. There, the per-instance evaluator report
# is the *source* of the verdict -- `resolved`, `patch_successfully_applied`,
# `infra_failure` and `tests_status` all live in it, and they are what
# separates a genuine FAIL from an undecided one. The `evaluator_resolved`
# boolean in a cell artifact is derived from that report and cannot stand in
# for it.
#
# So a retrieval bundle from a real run must collect the evaluator reports and
# their digests explicitly. Being ignored here must never become "we kept only
# the boolean".
logs/run_evaluation/pilot_*/
