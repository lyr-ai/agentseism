{"step": 21, "command": "cat > /testbed/test_edge_cases.py << 'EOF'\nimport logging\n\ndef test_clear_maintains_consistency(caplog) -> None:\n    \"\"\"Test that caplog.get_records() and caplog.records stay in sync after clear().\"\"\"\n    def verify_consistency() -> None:\n        assert caplog.get_records(\"call\") == caplog.records\n\n    # Initial state should be consistent\n    verify_consistency()\n    assert len(caplog.records) == 0\n    \n    # Add a log record\n    logging.warning(\"test1\")\n    verify_consistency()\n    assert len(caplog.records) == 1\n    \n    # Clear should maintain consistency\n    caplog.clear()\n    verify_consistency()\n    assert len(caplog.records) == 0\n    \n    # After clear, new logs should appear in both\n    logging.warning(\"test2\")\n    verify_consistency()\n    assert len(caplog.records) == 1\n    assert caplog.records[0].getMessage() == \"test2\"\n    \n    # Multiple clears should work\n    caplog.clear()\n    verify_consistency()\n    caplog.clear()\n    verify_consistency()\n\n\ndef test_clear_preserves_phase_isolation(caplog) -> None:\n    \"\"\"Test that clear() only clears the current phase's records.\"\"\"\n    caplog.set_level(logging.INFO)\n    logging.info(\"before_clear\")\n    records_before = len(caplog.records)\n    \n    caplog.clear()\n    \n    # The stash should be cleared for the current phase\n    assert len(caplog.get_records(\"call\")) == 0\n    assert len(caplog.records) == 0\n    \n    # New records should be captured\n    logging.info(\"after_clear\")\n    assert len(caplog.records) == 1\n    assert caplog.records[0].getMessage() == \"after_clear\"\n    assert len(caplog.get_records(\"call\")) == 1\nEOF\ncd /testbed && python -m pytest test_edge_cases.py -v", "returncode": 0, "first_snapshot": false, "source_changed": false, "workspace_changed": true, "timestamp": 1788931048.540101, "changed_files": ["src/_pytest/logging.py"], "untracked_files": ["test_edge_cases.py", "test_reproduce.py"], "tr