{"step": 3, "command": "cat > /testbed/test_reproduce_extended.py << 'EOF'\nimport logging\n\ndef test_caplog_clear_multiple_times(caplog) -> None:\n    \"\"\"Test that clear() can be called multiple times.\"\"\"\n    logging.warning(\"test1\")\n    assert len(caplog.records) == 1\n    caplog.clear()\n    assert len(caplog.records) == 0\n    caplog.clear()  # Second clear should work fine\n    assert len(caplog.records) == 0\n\ndef test_caplog_records_after_clear(caplog) -> None:\n    \"\"\"Test that new records are properly captured after clear().\"\"\"\n    logging.warning(\"test1\")\n    assert len(caplog.records) == 1\n    caplog.clear()\n    assert len(caplog.records) == 0\n    logging.warning(\"test2\")\n    assert len(caplog.records) == 1\n    assert caplog.records[0].getMessage() == \"test2\"\n\ndef test_caplog_text_after_clear(caplog) -> None:\n    \"\"\"Test that text is properly cleared.\"\"\"\n    logging.warning(\"test1\")\n    assert \"test1\" in caplog.text\n    caplog.clear()\n    assert \"test1\" not in caplog.text\n    assert caplog.text == \"\"\n\ndef test_caplog_get_records_consistency(caplog) -> None:\n    \"\"\"Test that get_records and records stay in sync after clear.\"\"\"\n    def verify_consistency():\n        assert caplog.get_records(\"call\") == caplog.records\n\n    verify_consistency()\n    logging.warning(\"test\")\n    verify_consistency()\n    caplog.clear()\n    verify_consistency()\n    logging.warning(\"test2\")\n    verify_consistency()\n\ndef test_caplog_messages_after_clear(caplog) -> None:\n    \"\"\"Test that messages property works correctly after clear.\"\"\"\n    logging.warning(\"test1\")\n    assert caplog.messages == [\"test1\"]\n    caplog.clear()\n    assert caplog.messages == []\n    logging.warning(\"test2\")\n    assert caplog.messages == [\"test2\"]\nEOF", "returncode": 0, "first_snapshot": false, "source_changed": false, "workspace_changed": true, "timestamp": 1788933923.4491572, "changed_files": ["src/_pytest/logging.py"], "untracked_files": ["test_reproduce.py", "test_reproduce_extended.py"], "tracked_diff_hash": "400ed4047a8253a9cc7268069f079099484f0d279b7bd225a309da40609896c0", "workspace_diff_hash": "0ec623b599b3d9f1efc42e1cd14baf5aeabf97eacf81cec98c2c6dff6f536221", "tracked_diff_bytes": 438}
