imestamp": 1788937245.5149791, "changed_files": ["src/_pytest/logging.py"], "untracked_files": ["test_reproduce.py", "test_reproduce_extended.py"], "tracked_diff_hash": "400ed4047a8253a9cc7268069f079099484f0d279b7bd225a309da40609896c0", "workspace_diff_hash": "8ce305cafc2fe3d648dae7b0f755125e53189a776e4783402eff7a9215d0a388", "tracked_diff_bytes": 438}
